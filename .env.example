# Server Configuration
PORT=3001
NODE_ENV=development

# Allowed Client Origin (for CORS in production)
CLIENT_ORIGIN=http://localhost:5173

# Supabase Configuration
# Server-side ONLY: Never expose SUPABASE_SECRET_KEY to the client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# JWT Secret for Admin Session Cookies
JWT_SECRET=your_jwt_secret_here

# Initial Admin Setup (Optional: used for initial database seed only)
INITIAL_SEED_EMAIL=
INITIAL_SEED_PASSWORD=
